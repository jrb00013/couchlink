COUCHLINK_BIND=0.0.0.0:8443
# Overridden at runtime by ./scripts/run.sh host --local|--online
COUCHLINK_SIGNALING=ws://127.0.0.1:8443/ws
COUCHLINK_SESSION_ID=friends-night
COUCHLINK_PIN=123456
COUCHLINK_PRESET=1080p60
# Optional pin for --online if ifconfig.me is blocked.
#COUCHLINK_PUBLIC_IP=
# PRIME mesh (Tailscale / WireGuard) — preferred by host --online when up.
# install.sh defaults to mesh tooling ON; disable with --no-mesh / COUCHLINK_INSTALL_MESH=0
#COUCHLINK_INSTALL_MESH=1
# host --online auto-runs enable-wireguard.sh when conf exists (set 0 to skip)
#COUCHLINK_AUTO_WIREGUARD=1
#COUCHLINK_SKIP_MESH=0
#COUCHLINK_MESH_PREFER=tailscale,wireguard
#COUCHLINK_WG_IF=wg0
#COUCHLINK_WG_HOST_IP=10.66.0.1
# Force mesh invite (e.g. Windows WireGuard + WSL host):
#COUCHLINK_MESH=wireguard
#COUCHLINK_MESH_IP=10.66.0.1
# Populated automatically by scripts/start-turn.sh on first --online run (non-mesh).
#COUCHLINK_TURN_URL=turn:YOUR_PUBLIC_IP:3478
#COUCHLINK_TURN_USER=
#COUCHLINK_TURN_PASS=
# Friend (client) online: paste the full host join URL (includes TURN) — preferred.
#COUCHLINK_JOIN_URL=http://YOUR_PUBLIC_IP:8443/?s=…&p=…&ws=…&turn=…&turnu=…&turnp=…
# WSL host → Windows browser: pin host LAN IP (from `hostname -I`), avoids Docker bridge ICE.
# WSL client: leave unset to auto-detect the Windows LAN IP for ICE host candidates.
#COUCHLINK_ICE_IPS=172.18.223.133
# WSL: auto-starts Windows capture with the host (default on WSL). Set 0 to disable.
#COUCHLINK_WINDOWS_CAPTURE=auto
# Capture target on Windows: picker (default) | desktop | window
#COUCHLINK_CAPTURE_SOURCE=picker
# Connect target for Windows → WSL capture (default: WSL eth0 IP, not 127.0.0.1).
#COUCHLINK_WIN_CAPTURE_CONNECT=172.18.223.133:9876
