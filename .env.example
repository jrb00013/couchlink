COUCHLINK_BIND=0.0.0.0:8443
COUCHLINK_SIGNALING=ws://127.0.0.1:8443/ws
COUCHLINK_SESSION_ID=friends-night
COUCHLINK_PIN=123456
COUCHLINK_PRESET=1080p60
# Populated automatically by scripts/start-turn.sh on first run.
#COUCHLINK_TURN_URL=turn:YOUR_PUBLIC_IP:3478
#COUCHLINK_TURN_USER=
#COUCHLINK_TURN_PASS=
# WSL → Windows browser: pin host LAN IP (from `hostname -I`), avoids Docker bridge ICE.
#COUCHLINK_ICE_IPS=172.18.223.133
# WSL: auto-starts Windows capture with the host (default on WSL). Set 0 to disable.
#COUCHLINK_WINDOWS_CAPTURE=auto
# Capture target on Windows: picker (default) | desktop | window
#COUCHLINK_CAPTURE_SOURCE=picker
# When matching a window by title substring:
#COUCHLINK_CAPTURE_WINDOW=PCSX2
